# Runtime: Supabase transaction pooler. Percent-encode password characters.
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@YOUR_POOLER:6543/postgres
# Local/CI migration tooling only: use the direct or session URL from Supabase Connect.
MIGRATION_DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@YOUR_POOLER:5432/postgres
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY
# Legacy alternative; unnecessary when the publishable key is configured.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
# Use the actual HTTPS application origin in Vercel, without a path.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Existing Supabase Auth user UUID to own the seeded cafe
SEED_USER_ID=
