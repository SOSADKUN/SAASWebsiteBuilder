# Runtime: Supabase transaction pooler. Percent-encode password characters.
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@YOUR_POOLER:6543/postgres
# Local/CI migration tooling only: use the direct or session URL from Supabase Connect.
MIGRATION_DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@YOUR_POOLER:5432/postgres
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY
# Legacy alternative; unnecessary when the publishable key is configured.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
# Use the actual HTTPS application origin in Vercel, without a path.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Existing Supabase Auth user UUID to own the seeded cafe
SEED_USER_ID=

# Server-only Supabase secret/service-role key for validated Storage operations. NEVER NEXT_PUBLIC.
SUPABASE_STORAGE_SERVICE_KEY=

# Optional public marketing/SEO origin. Set only to an owned, verified HTTPS domain.
# Separate from Auth callbacks. Do not set servqoo.com until ownership/HTTPS are verified.
SERVQOO_PUBLIC_ORIGIN=
# Shared public and Dashboard > Settings > Contact SERVQOO channels.
# Blank/invalid WhatsApp values hide the option; unavailable dashboard email stays disabled.
# WhatsApp: international country code + number, digits only (no +, spaces or leading local 0).
SERVQOO_CONTACT_EMAIL=
SERVQOO_WHATSAPP_NUMBER=

# Optional comma-separated verified old hosts; redirects PUBLIC marketing paths only. Blank disables.
SERVQOO_REDIRECT_FROM_HOSTS=
